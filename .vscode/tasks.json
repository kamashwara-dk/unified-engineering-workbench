{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Package (Release)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\package.ps1", "-CandidateId", "CANDIDATE"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Run Workbench",
      "type": "shell",
      "command": "${workspaceFolder}\\dist\\Launch.exe",
      "args": [],
